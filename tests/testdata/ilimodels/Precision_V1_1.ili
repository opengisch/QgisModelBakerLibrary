INTERLIS 2.3;

MODEL Precision_V1_1 (en) AT "https://modelbaker.ch" VERSION "2023-03-29" =
  DOMAIN
    Integer = -2000000000 .. 2000000000;
    Real = -2000000000.000 .. 2000000000.000;

  TOPIC Precision =

    CLASS PrecClass  =
      Textattribute : MANDATORY TEXT*99;
      Zero: 0 .. 99;

      One9: 0.0 .. 9.9;
      Two9: 0.00 .. 99.99;
      Three9: 0.000 .. 999.999;
      Eight9 : 0.00000000 .. 99999999.99999999;
      One0: 0.0 .. 9.0;
      Two0: 0.00 .. 99.00;
      Three0: 0.000 .. 999.000;
      Eight0 : 0.00000000 .. 99999999.00000000;

      IntegerValue : Integer;
      RealValue : Real;
    END PrecClass;

  END Precision;

END Precision_V1_1.
